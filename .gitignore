# data/ is ignored except the small files that let T4-T7 rerun without SEC downloads
# (`make from-scores`); see data/README.md. Raw filings, clean text and sections stay ignored.
# CRSP files and the prices/returns built from them are licensed data and stay ignored too
# (README_DATA.md); `make check-data` and the pre-commit hook enforce it.
data/*
!data/README.md
!data/sp500_proxy.py
!data/similarity.parquet
!data/reports/
data/reports/*
!data/reports/download.json
!data/reports/clean.json
!data/reports/score.json
outputs/
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.DS_Store
